# GEMINI_API_KEY: Legacy AI Studio configuration for existing frontend tooling.
# Never expose provider secrets to browser bundles in production.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI Provider (server-side only).
# API key must be configured as a deployment secret and must never be committed.
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_DEFAULT_MODEL="gpt-5.6-luna"
OPENAI_TIMEOUT_MS="30000"

# OpenRouter (server-side only).
# Used by the canonical CI AI code-review workflow.
# Configure the GitHub Actions secret OPENROUTER_API_KEY and repository variables:
# OPENROUTER_AI_REVIEW_MODEL_ID (optional; defaults to openrouter/auto-beta)
# OPENROUTER_AI_REVIEW_FALLBACK_MODELS (optional; comma-separated model IDs)
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_AI_REVIEW_MODEL_ID="openrouter/auto-beta"
OPENROUTER_AI_REVIEW_FALLBACK_MODELS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

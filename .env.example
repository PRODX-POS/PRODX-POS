# GEMINI_API_KEY: Legacy AI Studio configuration for existing frontend tooling.
# Never expose provider secrets to browser bundles in production.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI Provider (server-side only).
# API key must be configured as a deployment secret and must never be committed.
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_DEFAULT_MODEL="gpt-5.6-luna"
OPENAI_TIMEOUT_MS="30000"

# OKMD AI Provider (server-side only).
# API key must be configured as a deployment secret and must never be committed.
OKMD_AI_BASE_URL="https://gen.ai.kku.ac.th/okmd/api/v1"
OKMD_AI_API_KEY="YOUR_OKMD_API_KEY"
OKMD_AI_DEFAULT_MODEL="gemini-2.5-flash-lite"
OKMD_AI_TIMEOUT_MS="30000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

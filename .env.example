# PostgreSQL — required by the production API server.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
DB_POOL_MAX="10"
PORT="8080"

# Browser-to-backend API base URL. Required outside development.
VITE_AUTH_API_BASE_URL="https://api.example.com"

# OpenRouter — server-side only. Never expose this secret to browser bundles.
# Configure the real key only in the deployment secret store.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_DEFAULT_MODEL="YOUR_OPENROUTER_MODEL_ID"
OPENROUTER_TIMEOUT_MS="30000"

# Optional public application URL.
APP_URL="https://pos.example.com"

{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "server:check": "tsc -p tsconfig.server.json",
    "server:test": "tsx --test server/**/*.test.ts",
    "server:test:integration": "DATABASE_URL=${DATABASE_URL:?DATABASE_URL is required} tsx --test server/auth/postgres.integration.test.ts server/db/postgres.integration.test.ts",
    "theme:validate": "tsx theme-validator.ts --check",
    "theme:fix": "tsx theme-validator.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "i18next": "^26.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "recharts": "^3.10.1",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
